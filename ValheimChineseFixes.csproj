<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>ValheimChineseFixes</RootNamespace>
    <AssemblyName>ValheimChineseFixes</AssemblyName>

    <Version>1.0.10</Version>
    <Title>Valheim Chinese Fixes</Title>
    <Authors>EwigLicht</Authors>
    <Description>Fixes Chinese localization issues in Valheim.</Description>
    <Copyright>Copyright © 2026 EwigLicht. All rights reserved.</Copyright>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <GameInstallPath>E:\Games\Steam\steamapps\common\Valheim\</GameInstallPath>
    <ModInstallPath>$(GameInstallPath)\BepInEx\plugins\ValheimChineseFixes\</ModInstallPath>
    <PackageInstallPath>$(MSBuildProjectDirectory)\package\BepInEx\plugins\ValheimChineseFixes\</PackageInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameInstallPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(GameInstallPath)\BepInEx\plugins\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameInstallPath)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameInstallPath)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CleanExtraDLLs" AfterTargets="Build">
    <ItemGroup>
      <ExtraDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <Delete Files="@(ExtraDlls)" />
  </Target>

  <Target Name="CopyToPlugins" AfterTargets="CleanExtraDLLs">
    <MakeDir Directories="$(ModInstallPath)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ModInstallPath)"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Fixes\Chinese.json"
      DestinationFolder="$(ModInstallPath)\Fixes\" SkipUnchangedFiles="true" />

    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(PackageInstallPath)"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Fixes\Chinese.json"
      DestinationFolder="$(PackageInstallPath)\Fixes\" SkipUnchangedFiles="true" />
  </Target>

</Project>