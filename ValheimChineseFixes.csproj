<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>ValheimChineseFixes</RootNamespace>
    <AssemblyName>ValheimChineseFixes</AssemblyName>

    <Version>0.1.0</Version>
    <Title>Valheim Chinese Fixes</Title>
    <Authors>EwigLicht</Authors>
    <Description>Fixes Chinese localization issues in Valheim.</Description>
    <Copyright>Copyright © 2026 EwigLicht. All rights reserved.</Copyright>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <ModInstallPath>E:\Games\Steam\steamapps\common\Valheim\BepInEx\plugins\ValheimChineseFixes\</ModInstallPath>

    <NoWarn>$(NoWarn);MSB3245</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <Target Name="CleanExtraDLLs" AfterTargets="Build">
    <ItemGroup>
      <ExtraDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <Delete Files="@(ExtraDlls)" />
  </Target>

  <Target Name="CopyToPlugins" AfterTargets="CleanExtraDLLs">
    <Message Text="正在将模组文件复制到: $(ModInstallPath)" Importance="high" />

    <MakeDir Directories="$(ModInstallPath)" />

    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ModInstallPath)"
      SkipUnchangedFiles="true" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)\Fixes\Chinese.json"
      DestinationFolder="$(ModInstallPath)\Fixes\"
      SkipUnchangedFiles="true" />
  </Target>

</Project>